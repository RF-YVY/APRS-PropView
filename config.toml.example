# APRS PropView Configuration
# Edit this file with your station details before starting

[station]
callsign = "N0CALL"
ssid = 0
latitude = 0.0
longitude = 0.0
symbol_table = "/"
symbol_code = "#"
phg = ""
equipment = ""
comment = "APRS PropView Digi/IGate"
beacon_interval = 1800  # seconds, 0 to disable

[digipeater]
enabled = true
# WIDEn-N aliases to respond to
aliases = ["WIDE1-1", "WIDE2-1"]
# Duplicate packet suppression window (seconds)
dedupe_interval = 30

[igate]
enabled = true
rf_to_is = true
is_to_rf = false

[aprs_is]
enabled = true
server = "rotate.aprs2.net"
port = 14580
passcode = "-1"
# Server-side filter string. Example: "r/35.0/-80.0/200" for 200km radius
filter = ""

[kiss_serial]
enabled = false
port = "COM3"
baudrate = 9600
# mode: "kiss" for binary KISS TNCs, "tnc2_monitor" for receive-only
# classic TNC2 monitor text streams such as older Kenwood packet modes.
mode = "kiss"
# flow_control: "none", "xonxoff", "rtscts", or "dsrdtr".
# Kenwood TH-D7/TH-D7E packet operation commonly uses xonxoff.
flow_control = "none"
# init_profile: "none", "kenwood_thd7", "kenwood_tmd700",
# "kenwood_thd72", or "generic_tnc2_kiss".
init_profile = "none"
# Optional extra command-mode lines sent after the selected profile.
# Use {callsign} to insert the configured station callsign.
init_commands = ""

[kiss_tcp]
enabled = false
host = "127.0.0.1"
port = 8001

# Optional multi-port RF configuration. If any [[rf_ports]] entries are
# present, APRS PropView uses them instead of the legacy [kiss_serial]/[kiss_tcp]
# blocks above. Add as many serial KISS/TNC2 and TCP KISS/AGWPE ports as needed.
#[[rf_ports]]
#name = "Vertical"
#enabled = true
#type = "serial"  # "serial" or "tcp"
#port = "COM3"
#baudrate = 9600
#mode = "kiss"  # "kiss" or "tnc2_monitor"
#flow_control = "none"
#init_profile = "none"
#init_commands = ""
#rx_only_rf = false  # disables local RF transmissions on this port
#rx_only_is = false  # disables APRS-IS-to-RF gated transmissions on this port
#
#[[rf_ports]]
#name = "Yagi KISS"
#enabled = true
#type = "tcp"
#host = "127.0.0.1"
#tcp_port = 8001
#protocol = "kiss"  # "kiss" or "agwpe"
#rx_only_rf = false
#rx_only_is = false

[web]
host = "127.0.0.1"
port = 14501
# Browser used when APRS PropView opens the UI at launch.
# Leave blank for the system default. Other values are detected in Settings.
launch_browser = ""
font_family = ""
map_tile_source = "osm"
map_tile_url = ""
map_tile_attribution = ""
map_tile_max_zoom = 19
unit_system = "imperial"
ghost_after_minutes = 60
expire_after_minutes = 0
mobile_pin = ""
update_check_enabled = true
update_check_interval_hours = 24

[database]
path = "propview.db"

[tracking]
# Maximum age for station records in seconds (default 24h)
max_station_age = 86400
# How often to purge old records (seconds)
cleanup_interval = 3600

[messaging]
# How many days to retain APRS message history in the database
message_retention_days = 30
# Also receive messages addressed to the same base callsign with any SSID.
# Example: if the station ID is K5YVY-1, messages to K5YVY-7 or K5YVY-9
# appear in the app inbox. Exact station-ID messages are still the only ones
# auto-ACKed by this running instance.
receive_sibling_ssids = true

[alerts]
enabled = false
anomaly_alert_enabled = true
sporadic_e_alert_enabled = true
my_min_stations = 3
my_min_distance_km = 100.0
regional_min_stations = 5
regional_min_distance_km = 100.0
cooldown_seconds = 1800
quiet_start = ""
quiet_end = ""
msg_notify_enabled = false
msg_discord_enabled = false
msg_email_enabled = false
msg_sms_enabled = false
audio_output_device_id = ""
audio_my_station_opening_file = ""
audio_regional_watch_file = ""
audio_first_heard_file = ""
audio_anomaly_file = ""
audio_sporadic_e_file = ""
audio_message_received_file = ""
audio_weather_warning_file = ""
audio_weather_watch_file = ""
discord_enabled = false
discord_webhook_url = ""
email_enabled = false
email_smtp_server = ""
email_smtp_port = 587
email_from = ""
email_to = ""
email_password = ""
sms_enabled = false
sms_gateway_address = ""

[propagation]
my_station_full_count = 10
my_station_full_dist_km = 200.0
regional_full_count = 10
regional_full_dist_km = 200.0

[status]
enabled = false
# Seconds between compact DX status beacons. Minimum is 10 minutes.
beacon_interval = 1800
mode = "both"  # both, rf, or aprs_is
path = "WIDE1-1"
report_window_minutes = 60
max_length = 67
source = "dx"  # dx, dynamic, or mheard
dynamic_order = "sequential"  # sequential or random
dynamic_messages = []
weather_alert_beacon_enabled = false
weather_alert_cooldown_minutes = 30

[smart_beaconing]
enabled = false
# Slow/parked station beacon interval in seconds. Minimum APRS-IS-safe value is 600.
slow_interval = 1800
# Fast/moving station beacon interval in seconds.
fast_interval = 120
# GPS speed at or above this value uses the fast interval.
speed_threshold_mph = 10.0

[bulletins]
enabled = false
# Seconds between scheduled bulletin batches. Minimum is 600.
interval = 1800
mode = "both"  # both, rf, or aprs_is
path = "WIDE1-1"
# Example item: { id = "1", text = "Club net tonight 7PM" }
items = []

[aprs_objects]
enabled = false
# Seconds between scheduled APRS object batches. Minimum is 600.
interval = 1800
mode = "both"  # both, rf, or aprs_is
path = "WIDE1-1"
# Example item:
# { name = "NET", latitude = 35.0, longitude = -80.0, symbol_table = "/", symbol_code = "r", comment = "Weekly net", mode = "both", path = "WIDE1-1" }
items = []

[weather]
enabled = false
location_code = ""
# Current sources: open_meteo, wxnow
current_provider = "open_meteo"
wxnow_condition_fallback_enabled = true
alert_provider = "auto"
weatherbit_api_key = ""
weatherbit_poll_minutes = 30
alert_range_miles = 40
refresh_minutes = 15
radar_enabled = false
radar_provider = "rainviewer"
radar_opacity = 0.55
radar_animate = true
alert_overlay_enabled = false
alert_overlay_range_miles = 80
alert_overlay_groups = ["warnings", "watches", "flood", "winter", "marine", "fire_heat", "other"]
alert_scope_mode = "point"
alert_scope_zone = ""
elevated_alert_polling_enabled = false
elevated_alert_polling_seconds = 60
elevated_alert_cooldown_minutes = 15
elevated_trigger_events = ["Tornado Watch", "Severe Thunderstorm Watch"]

[wxnow]
enabled = false
# Path to the WXnow.txt file generated by your weather station software.
file_path = ""
# Weather stations commonly use SSID -13.
ssid = 13
# Seconds between weather beacon attempts. APRS-IS minimum is 10 minutes.
beacon_interval = 600
# Stop beaconing if WXnow.txt has not been updated within this many minutes.
max_age_minutes = 15
include_position = true
mode = "both"  # both, rf, or aprs_is
path = "WIDE1-1"
symbol_table = "/"
symbol_code = "_"

[gps]
# Sources: browser, self_packet, nmea_serial, nmea_tcp, nmea_udp, gpsd, any
enabled = false
source = "browser"
map_update_enabled = true
update_station_position = false
station_position_locked = true
serial_port = "COM4"
serial_baudrate = 9600
tcp_host = "127.0.0.1"
tcp_port = 10110
udp_host = "0.0.0.0"
udp_port = 10110
gpsd_host = "127.0.0.1"
gpsd_port = 2947

[mqtt]
enabled = false
broker = "localhost"
port = 1883
topic_prefix = "aprs/propview"
username = ""
password = ""
# Publish retained Home Assistant MQTT Discovery config topics.
discovery_enabled = false
discovery_prefix = "homeassistant"
device_name = "APRS PropView"
# Keep this stable once Home Assistant discovers the entities.
device_id = "aprs_propview"
# Optional callsigns to publish as retained Home Assistant watched-station entities.
watched_callsigns = []

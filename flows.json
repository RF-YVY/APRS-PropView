  {
    "id": "apv-normalize-prop",
    "type": "function",
    "z": "apv-flow",
    "name": "Format propagation widgets",
    "func": "const parsePayload = value => {\n  if (typeof value !== 'string') return value || {};\n  try { return JSON.parse(value); }\n  catch (err) { node.warn(`Unable to parse propagation payload: ${err.message}`); return {}; }\n};\nconst p = parsePayload(msg.payload);\nconst n = (value, places = 1) => Number.isFinite(Number(value)) ? Number(value).toFixed(places) : '0.0';\nconst ts = p.timestamp ? new Date(Number(p.timestamp) * 1000).toLocaleString() : new Date().toLocaleString();\nconst myScore = Number(p.my_score || 0);\nconst regScore = Number(p.regional_score || 0);\nconst maxKm = Number(p.max_distance_km || 0);\nconst miles = maxKm * 0.621371;\nconst rf1h = Number(p.rf_stations_1h || 0);\nreturn [\n  { payload: `My ${n(myScore)}% (${p.my_level || 'none'}) | Regional ${n(regScore)}% (${p.regional_level || 'none'}) | RF ${rf1h}/hr | Max ${n(maxKm)} km / ${n(miles)} mi | ${ts}` },\n  { payload: myScore },\n  { payload: regScore },\n  { topic: 'Regional score', payload: regScore },\n  { topic: 'Max distance km', payload: maxKm },\n  { payload: `${p.my_level || 'none'}` },\n  { payload: `${p.regional_level || 'none'}` },\n  { payload: `${n(maxKm)} km / ${n(miles)} mi` },\n  { payload: rf1h }\n];",
    "outputs": 9,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 610,
    "y": 80,
    "wires": [
      [
        "apv-prop-summary"
      ],
      [
        "apv-my-gauge"
      ],
      [
        "apv-reg-gauge"
      ],
      [
        "apv-score-chart"
      ],
      [
        "apv-distance-chart"
      ],
      [
        "apv-my-level"
      ],
      [
        "apv-reg-level"
      ],
      [
        "apv-max-distance"
      ],
      [
        "apv-rf-1h"
      ]
    ]
  },

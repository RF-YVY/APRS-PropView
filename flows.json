  {
    "id": "apv-action-router",
    "type": "function",
    "z": "apv-flow",
    "name": "Build PropView HTTP action",
    "func": "const baseUrl = flow.get('aprsPropViewBaseUrl') || 'http://127.0.0.1:14501';\nconst action = String(msg.payload || msg.topic || '').toLowerCase();\nconst routes = {\n  beacon: { url: '/api/beacon/transmit', payload: { mode: 'both' } },\n  wxnow: { url: '/api/wxnow/transmit', payload: {} },\n  bulletins: { url: '/api/bulletins/transmit', payload: {} },\n  objects: { url: '/api/objects/transmit', payload: {} }\n};\nif (!routes[action]) {\n  node.warn(`Unknown APRS PropView action: ${action}`);\n  return null;\n}\nmsg.method = 'POST';\nmsg.url = `${baseUrl}${routes[action].url}`;\nmsg.headers = { 'content-type': 'application/json' };\nmsg.payload = routes[action].payload;\nmsg.apvAction = action;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 460,
    "y": 620,
    "wires": [
      [
        "apv-propview-url"
      ]
    ]
  },
  {
    "id": "apv-action-result",
    "type": "function",
    "z": "apv-flow",
    "name": "Format action result",
    "func": "const body = msg.payload || {};\nconst ok = body.success !== false && (msg.statusCode == null || msg.statusCode < 400);\nconst label = (msg.apvAction || 'Action').replace(/^./, c => c.toUpperCase());\nconst detail = body.message || (ok ? 'sent' : 'failed');\nreturn [\n  { payload: `${label}: ${detail}`, topic: ok ? 'APRS PropView' : 'APRS PropView error' },\n  { payload: ok ? true : false }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1000,
    "y": 560,
    "wires": [
      [
        "apv-action-toast",
        "apv-action-text"
      ],
      []
    ]
  },

  {
    "id": "apv-alexa-command",
    "type": "function",
    "z": "apv-flow",
    "name": "Map Alexa command to action",
    "func": "const device = String(msg.device_name || msg.devicename || msg.name || msg.topic || '').toLowerCase();\nconst p = msg.payload || {};\nconst isOn = p.on === true || p === true || String(p).toLowerCase() === 'on';\nif (!isOn) {\n  return [{ payload: `Alexa ${device}: off command ignored`, topic: 'APRS PropView' }, null];\n}\nlet action = '';\nif (device.includes('beacon')) action = 'beacon';\nif (device.includes('wx')) action = 'wxnow';\nif (device.includes('bulletin')) action = 'bulletins';\nif (device.includes('object')) action = 'objects';\nif (!action) return [{ payload: `Alexa ${device}: no mapped action`, topic: 'APRS PropView' }, null];\nreturn [\n  { payload: `Alexa requested ${action}`, topic: 'APRS PropView' },\n  { payload: action, topic: 'alexa' }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],

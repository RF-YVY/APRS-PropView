  {
    "id": "apv-format-event",
    "type": "function",
    "z": "apv-flow",
    "name": "Format event line",
    "func": "const parsePayload = value => {\n  if (typeof value !== 'string') return value || {};\n  try { return JSON.parse(value); }\n  catch (err) { node.warn(`Unable to parse event payload: ${err.message}`); return {}; }\n};\nconst e = parsePayload(msg.payload);\nconst eventName = e.event || e.type || 'event';\nconst call = e.callsign || e.from || '';\nconst dist = e.distance_km == null ? '' : ` ${Number(e.distance_km).toFixed(1)} km`;\nconst text = `${new Date().toLocaleTimeString()} - ${eventName}${call ? ` - ${call}` : ''}${dist}`;\nreturn [\n  { payload: text },\n  { payload: text, topic: 'APRS PropView' }\n];",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,

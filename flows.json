  {
    "id": "apv-normalize-status",
    "type": "function",
    "z": "apv-flow",
    "name": "Format status widgets",
    "func": "const parsePayload = value => {\n  if (typeof value !== 'string') return value || {};\n  try { return JSON.parse(value); }\n  catch (err) { node.warn(`Unable to parse status payload: ${err.message}`); return {}; }\n};\nconst s = parsePayload(msg.payload);\nconst on = value => String(value || '').toUpperCase() === 'ON';\nconst age = s.last_rf_packet_age_seconds == null ? 'n/a' : `${s.last_rf_packet_age_seconds}s`;\nconst summary = `RF ${on(s.rf_interface_connected) ? 'online' : 'offline'} | APRS-IS ${on(s.aprs_is_connected) ? 'online' : 'offline'} | Last RF ${age} | Stations RF ${s.rf_station_count ?? 0} / IS ${s.aprs_is_station_count ?? 0}`;\nreturn [\n  { payload: summary },\n  { payload: on(s.rf_interface_connected) ? 'ON' : 'OFF' },\n  { payload: on(s.aprs_is_connected) ? 'ON' : 'OFF' },\n  { payload: age },\n  { payload: on(s.band_opening_active) ? 'ON' : 'OFF' },\n  { payload: on(s.aprs_message_waiting) ? 'ON' : 'OFF' },\n  { payload: on(s.weather_warning_active) ? 'ON' : 'OFF' },\n  { payload: { on: on(s.band_opening_active) } }\n];",
    "outputs": 8,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 590,
    "y": 440,
    "wires": [
